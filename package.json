{
  "name": "pranav-shende-portfolio-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:server": "npm --prefix server run dev",
    "server": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start",
    "server:seed": "npm --prefix server run prisma:seed",
    "build": "node scripts/sync_seo.cjs && npm --prefix frontend run build",
    "build:frontend": "node scripts/sync_seo.cjs && npm --prefix frontend run build",
    "build:server": "npm --prefix server run build",
    "start": "npm --prefix frontend run start",
    "preview": "npm --prefix frontend run preview"
  },
  "workspaces": [
    "frontend",
    "server"
  ],
  "dependencies": {
    "pg": "^8.13.1"
  }
}
